{
    "name": "chrisbracco.com",
    "version": "2.2.0",
    "description": "The source code for Chris Bracco's personal website.",
    "main": "index.js",
    "scripts": {
        "clean": "rm -rf ./public",
        "build": "npm-run-all clean build:vite build:eleventy",
        "build:eleventy": "NODE_ENV=production eleventy",
        "build:vite": "vite build",
        "dev": "npm-run-all clean --parallel dev:*",
        "dev:eleventy": "NODE_ENV=development eleventy --watch --quiet",
        "dev:vite": "wait-on public/index.html && vite",
        "prod": "npm-run-all build && serve --no-clipboard --listen 8080 public",
        "start": "npm-run-all dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cbracco/chrisbracco.com.git"
    },
    "keywords": [
        "website"
    ],
    "author": "Chris Bracco",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/cbracco/chrisbracco.com/issues"
    },
    "homepage": "https://github.com/cbracco/chrisbracco.com#readme",
    "devDependencies": {
        "@11ty/eleventy": "^3.1.5",
        "@11ty/eleventy-img": "^6.0.4",
        "@11ty/eleventy-navigation": "^1.0.5",
        "@11ty/eleventy-plugin-rss": "^3.0.0",
        "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
        "cssnano": "^8.0.1",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "fast-glob": "^3.2.5",
        "glob": "^13.0.6",
        "luxon": "^3.7.2",
        "markdown-it": "^14.2.0",
        "markdown-it-footnote": "^4.0.0",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.2.10",
        "postcss-import": "^16.1.1",
        "postcss-preset-env": "^11.3.0",
        "prettier": "^3.8.3",
        "serve": "^14.2.6",
        "svg-sprite": "^2.0.4",
        "vinyl": "^3.0.1",
        "vite": "^8.0.16",
        "wait-on": "^9.0.10"
    },
    "dependencies": {
        "emoji-blast": "^0.11.0",
        "lazysizes": "^5.3.2",
        "lightgallery": "^2.9.0"
    }
}
